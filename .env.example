APP_NAME=Laravel
# Production: APP_ENV=production, APP_DEBUG=false, LOG_LEVEL=warning
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Production: alamat https lengkap, mis. https://rangkul.id. Dipakai untuk link di email
# (dikirim lewat antrean, tanpa request) dan memaksa semua URL memakai https.
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rangkul
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# Lokal: sync (email langsung dikirim). Production: database (email mengantre di tabel jobs dan
# dikirim oleh scheduler setiap menit, sehingga request tidak menunggu SMTP).
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=true
# Production (HTTPS): cookie sesi hanya dikirim lewat HTTPS
SESSION_SECURE_COOKIE=false

# ---- Keamanan (config/security.php, config/trustedproxy.php) ----
# Production di belakang Cloudflare: isi rentang IP Cloudflare (https://www.cloudflare.com/ips/),
# dipisah koma. Kosongkan di lokal.
TRUSTED_PROXIES=
# HSTS dalam detik, hanya dikirim lewat https. 0 = mati. Mulai 300, naikkan ke 31536000 setelah stabil.
SECURITY_HSTS_MAX_AGE=0
# Penguncian login per akun: setelah N kali password salah, email itu dikunci selama sekian detik.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# ---- Backup (config/backup.php) ----
# Production: backups,backups_offsite (salinan lokal + bucket di luar server)
BACKUP_DISKS=backups
BACKUP_KEEP_DAYS=14
# Folder mysqldump bila tidak ada di PATH, mis. D:/laragon/bin/mysql/mysql-8.0.30-winx64/bin
DB_DUMP_BINARY_PATH=
# Bucket S3-compatible untuk backups_offsite, mis. Cloudflare R2:
# endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com, region auto
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=

# ---- Monitoring (healthchecks.io) ----
# URL ping check; alert dikirim jika ping berhenti (scheduler/cron mati atau backup gagal).
HEALTHCHECK_SYNC_URL=
HEALTHCHECK_BACKUP_URL=

# Production: domain frontend yang boleh memanggil /api (pisahkan dengan koma), mis. https://rangkul.com
CORS_ALLOWED_ORIGINS=*

# Password awal akun admin dari AdminUserSeeder. Wajib diisi (min. 12 karakter) di luar local/testing;
# jika kosong di local/testing, dipakai 'password123'.
ADMIN_SEED_PASSWORD=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@rangkul.com"
MAIL_FROM_NAME="${APP_NAME}"

# Masa berlaku token login dalam menit. Token disimpan di localStorage, jadi masa berlaku pendek
# membatasi dampak jika token bocor (10080 = 7 hari; default config 30 hari).
SANCTUM_EXPIRATION=10080

# Pembayaran donasi & premium (Midtrans sandbox)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

# Pencarian (jalankan meilisearch.exe di port 7700)
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

PREMIUM_PRICE=1000000
PREMIUM_DURATION_MONTHS=12
