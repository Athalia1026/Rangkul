# --- Laravel Standard Ignores ---
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*.log
/vendor
.env
.env.backup
.env.production
.env.testing
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log

# --- Caches & Testing ---
/.phpunit.cache
/.fleet
/.idea

# --- VS Code Configurations ---
/.vscode/launch.json
/.vscode/state.vscdb
/.vscode/state.vscdb.backup

# --- OS / System Generated Files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Database & Local Storage ---
/database/*.sqlite
/database/*.sqlite-journal